# Server


# Port the backend server listens on
PORT=3000

# Application environment: development | production | test
NODE_ENV=development

# URL of the frontend (used for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Database (for local dev with Docker)
# PostgreSQL connection string
# For local dev with Docker: matches the docker-compose.yml defaults
DATABASE_URL="postgresql://cognifast:cognifast@localhost:5433/cognifast_db"

# Supabase
# Found at: https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=your-supabase-project-url
# Use the service role key (NOT the anon key): keep this secret.
SUPABASE_KEY=your-supabase-service-role-key

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
